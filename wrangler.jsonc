{
  // micahstelter.ai — Worker + static assets.
  //
  // `name` MUST stay "micahstelter-site": it is what binds this config to the
  // existing Worker. A different name would deploy a brand new Worker and leave
  // the live site pointing at the old one.
  //
  // Assets are served first for any path that matches a file, so _redirects,
  // _headers and 404.html keep working exactly as before. Only unmatched paths
  // reach worker/index.js.
  "name": "micahstelter-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Bindings live here, not in the dashboard: this project deploys with
  // `wrangler deploy`, which treats this file as the source of truth and would
  // drop anything added through the UI on the next build. Secrets are the
  // exception — they are stored separately and survive deploys.
  // Cloudflare Workers AI — lets /api/babble run with no API key at all.
  "ai": { "binding": "AI" },
  // Cloudflare Access app "The CEO Seat" (created 2026-10-28) guards /bpc and
  // /api/bpc. None of these are secrets: the team domain and AUD are public in
  // every Access redirect, and the allow-list is enforced by Access first.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "little-field-0077.cloudflareaccess.com",
    "ACCESS_AUD": "52caf20dbe71f183a9bc1c0987d09de5d11627f41db27805e883469d682d96b8",
    "ACCESS_ALLOWED_EMAILS": "micah@aleph-mgmt.com,micahstelter@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "BPC_DB",
      "database_name": "bpc-momentum",
      "database_id": "375468b0-dd87-447a-8027-0471077b5446"
    }
  ]
}
